# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Fylvix Worldwide Entertainment Platform Configuration
# Configure actual secrets via the Secrets panel in AI Studio.
# Note: Do not paste raw multi-line JSON with double quotes into secret values,
# as the Android Secrets Gradle Plugin injects values directly into Java string literals.
# API_BASE_URL=
METADATA_API_URL=https://metadata.fylvix.global
METADATA_API_KEY=FYLVIX_METADATA_PROVIDER_KEY_PLACEHOLDER
# MEDIA_API_URL=
# ANALYTICS_KEY=
